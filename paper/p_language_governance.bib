  issn = {2096-2274},
  url = {https://kns.cnki.net/KCMS/detail/detail.aspx?dbcode=CJFD&dbname=CJFDLAST2017&filename=SZYA201701013&v=},
  abstract = {对于进入工业化时代的现代国家而言,国内地区间在行政体制、经济制度、文化模式等方面进行整合是历史的必然,需要建立学校接受工业文明知识体系,也需要推行国内通用语。由于中国各族之间的语言文化及经济发展基础的差异,现代学校体系的发展呈现地区"梯度"现象。同时,少数族群人口规模制约了其母语出版物的发展,汉语成为中华民族各族学习现代知识的主要工具。1949年后,一些民族自治地方实行"民语学校"和"汉语学校"双轨制。由于"民语学校"毕业生就业困难,少数族群劳动力很难进入"非农"行业就业,2000年后新疆等地少数族群劳动力就业形势愈发严峻。为了改变这一现状,加强汉语学习和双语教育已成为中国少数族群融入现代化进程的桥梁,这是国家教育政策调整所需研究的重要专题。},
  langid = {chinese},
  keywords = {🤓,Bilingual education,Domestic common language,双语教育 Modern knowledge,国家通用语,现代知识体系},
  annotation = {8 citations(CNKI)[2021-06-12]},
  file = {E:\政治效能感\马\马_2017_汉语学习与中国少数族群的现代化.pdf}
}

@article{YuWeiQi2017,
